<Project>
  <PropertyGroup>
    <!-- 中間ファイル(obj)と出力(bin)を両方 Mac 内蔵 SSD (APFS) に置くことで ._* の発生を完全に根絶 -->
    <BaseIntermediateOutputPath>/tmp/mp_build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>/tmp/mp_build/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/._*;**/.DS_Store</DefaultItemExcludes>
    <WarningLevel>0</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
      <NoWarn>$(NoWarn);MSB3568;MSB3243;MSB3277;NU1902;NU1903;NU1904;XA1008;MSB3539;NETSDK1138;CS0168;CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/._*" />
    <Compile Remove="**/._*.cs" />
  </ItemGroup>
</Project>