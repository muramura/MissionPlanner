                                                    </StackLayout>
                                                </Frame>

                                                <!-- Low Voltage Action (BATT_FS_LOW_ACT) -->
                                                <Frame Grid.Column="1" BackgroundColor="#0F172A" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                                    <StackLayout Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="Low Battery Action" TextColor="#F59E0B" FontSize="10" FontAttributes="Bold"/>
                                                            <Label x:Name="LBL_batt_fs_low_act_fc" Grid.Column="1" Text="None (0)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                                        </Grid>
                                                        <Label Text="Failsafe action (BATT_FS_LOW_ACT):" TextColor="#64748B" FontSize="8"/>
                                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                            <Button x:Name="Btn_LowAct_0" Grid.Column="0" Text="None (0)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnLowActClicked"/>
                                                            <Button x:Name="Btn_LowAct_1" Grid.Column="1" Text="🛬 Land (1)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnLowActClicked"/>
                                                            <Button x:Name="Btn_LowAct_2" Grid.Column="2" Text="🏠 RTL (2)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnLowActClicked"/>
                                                        </Grid>
                                                    </StackLayout>
                                                </Frame>
                                            </Grid>

                                            <!-- Row B: Critical Battery Threshold & Action -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <!-- Critical Voltage (BATT_CRT_VOLT) -->
                                                <Frame Grid.Column="0" BackgroundColor="#0F172A" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                                    <StackLayout Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="🚨 Critical Voltage (Emergency)" TextColor="#EF4444" FontSize="10" FontAttributes="Bold"/>
                                                            <Label x:Name="LBL_batt_crt_volt_fc" Grid.Column="1" Text="3.30 V" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                                        </Grid>
                                                        <Label Text="Voltage threshold (BATT_CRT_VOLT):" TextColor="#64748B" FontSize="8"/>
                                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                            <Button x:Name="Btn_CrtVolt_340" Grid.Column="0" Text="3.40V" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtVoltPresetClicked"/>
                                                            <Button x:Name="Btn_CrtVolt_335" Grid.Column="1" Text="3.35V" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtVoltPresetClicked"/>
                                                            <Button x:Name="Btn_CrtVolt_330" Grid.Column="2" Text="3.30V" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtVoltPresetClicked"/>
                                                            <Button x:Name="Btn_CrtVolt_320" Grid.Column="3" Text="3.20V" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtVoltPresetClicked"/>
                                                        </Grid>
                                                    </StackLayout>
                                                </Frame>

                                                <!-- Critical Voltage Action (BATT_FS_CRT_ACT) -->
                                                <Frame Grid.Column="1" BackgroundColor="#0F172A" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                                    <StackLayout Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="Critical Action" TextColor="#EF4444" FontSize="10" FontAttributes="Bold"/>
                                                            <Label x:Name="LBL_batt_fs_crt_act_fc" Grid.Column="1" Text="Land (1)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                                        </Grid>
                                                        <Label Text="Failsafe action (BATT_FS_CRT_ACT):" TextColor="#64748B" FontSize="8"/>
                                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                            <Button x:Name="Btn_CrtAct_0" Grid.Column="0" Text="None (0)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtActClicked"/>
                                                            <Button x:Name="Btn_CrtAct_1" Grid.Column="1" Text="🛬 Land (1)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtActClicked"/>
                                                            <Button x:Name="Btn_CrtAct_2" Grid.Column="2" Text="🏠 RTL (2)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnCrtActClicked"/>
                                                        </Grid>
                                                    </StackLayout>
                                                </Frame>
                                            </Grid>
                                        </StackLayout>
                                    </Frame>

                                    <!-- 3. Landing Auto-Disarm & Pre-Arm Safety Checks -->
                                    <Frame BackgroundColor="#1E293B" BorderColor="#334155" Padding="10,8" CornerRadius="8" HasShadow="False">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <!-- Auto Disarm Delay (DISARM_DELAY) -->
                                            <StackLayout Grid.Column="0" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="⏱️ Auto Disarm Delay" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                                    <Label x:Name="LBL_disarm_delay_fc" Grid.Column="1" Text="10 s" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                                </Grid>
                                                <Label Text="Motors stop after landing (DISARM_DELAY):" TextColor="#64748B" FontSize="8"/>
                                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                                    <Button x:Name="Btn_Delay_0" Grid.Column="0" Text="Off (0)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnDisarmDelayClicked"/>
                                                    <Button x:Name="Btn_Delay_5" Grid.Column="1" Text="5 s" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnDisarmDelayClicked"/>
                                                    <Button x:Name="Btn_Delay_10" Grid.Column="2" Text="10 s" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnDisarmDelayClicked"/>
                                                    <Button x:Name="Btn_Delay_15" Grid.Column="3" Text="15 s" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnDisarmDelayClicked"/>
                                                </Grid>
                                            </StackLayout>

                                            <!-- Pre-Arm Safety Checks (ARMING_CHECK) -->
                                            <StackLayout Grid.Column="1" Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="🛡️ Pre-Arm Checks" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                                    <Label x:Name="LBL_arming_check_fc" Grid.Column="1" Text="All (1)" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                                </Grid>
                                                <Label Text="Arming safety check mask (ARMING_CHECK):" TextColor="#64748B" FontSize="8"/>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                                    <Button x:Name="Btn_Check_All" Grid.Column="0" Text="✅ All Checks (1)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnArmingCheckClicked"/>
                                                    <Button x:Name="Btn_Check_Skip" Grid.Column="1" Text="⚠️ Skip Checks (0)" FontSize="9" HeightRequest="26" Padding="0" CornerRadius="4" BackgroundColor="#1E293B" TextColor="#94A3B8" Clicked="OnArmingCheckClicked"/>
                                                </Grid>
                                            </StackLayout>
                                        </Grid>
                                    </Frame>

                                </StackLayout>
                            </ScrollView>

                            <!-- Footer Actions -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Button Grid.Column="0" Text="🔄 Refresh Parameters" BackgroundColor="#0284C7" TextColor="#FFFFFF"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="32" CornerRadius="6" Padding="12,0"
                                        Clicked="OnRefreshArmingParamsClicked"/>
                                <Label Grid.Column="1"/>
                                <Button Grid.Column="2" Text="🎮 Open Joystick Button Setup" BackgroundColor="#334155" TextColor="#38BDF8"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="32" CornerRadius="6" Padding="12,0"
                                        Clicked="OnOpenJoystickFromArmingClicked"/>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            </Frame>
        </Grid>

        <!-- ================= 7. TELEMETRY DIAGNOSTICS & CALIBRATION MODAL ================= -->
        <Grid x:Name="Pnl_DiagModal" Margin="0" Padding="0" BackgroundColor="#E60B1120" IsVisible="False">
            <Frame Margin="12,8" Padding="12,10" CornerRadius="12" HasShadow="True"
                   BackgroundColor="#0F172A" BorderColor="#38BDF8"
                   VerticalOptions="FillAndExpand" HorizontalOptions="CenterAndExpand"
                   WidthRequest="740">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <!-- Row 0: Title Bar with Close Button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                            <Label Text="📊" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Telemetry Diagnostics &amp; Calibration" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="(INSPECTOR)" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                        <Button Grid.Column="1" Text="✕ Close" BackgroundColor="#334155" TextColor="#F1F5F9" FontSize="11" FontAttributes="Bold"
                                HeightRequest="28" Padding="10,0" CornerRadius="6" Clicked="OnCloseDiagModalClicked"/>
                    </Grid>

                    <!-- Row 1: Sub-tabs (EKF Status / Vibration & Clipping / Sensor Calib Inspector) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button x:Name="Btn_DiagTab_Ekf" Grid.Column="0" Text="🧭 EKF Status"
                                BackgroundColor="#0284C7" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold"
                                HeightRequest="30" CornerRadius="6" Padding="0" Clicked="OnDiagTabEkfClicked"/>
                        <Button x:Name="Btn_DiagTab_Vibe" Grid.Column="1" Text="📳 Vibration"
                                BackgroundColor="#1E293B" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"
                                HeightRequest="30" CornerRadius="6" Padding="0" Clicked="OnDiagTabVibeClicked"/>
                        <Button x:Name="Btn_DiagTab_Calib" Grid.Column="2" Text="📋 Sensor Diagnostics"
                                BackgroundColor="#1E293B" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"
                                HeightRequest="30" CornerRadius="6" Padding="0" Clicked="OnDiagTabCalibClicked"/>
                    </Grid>

                    <!-- Row 2: Tab Content Area -->
                    <Grid Grid.Row="2">
                        <!-- ================= EKF Status View ================= -->
                        <ScrollView x:Name="View_Diag_Ekf" IsVisible="True">
                            <StackLayout Spacing="8">
                                <!-- Overall Health Card -->
                                <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <StackLayout Orientation="Vertical" Spacing="2">
                                            <Label Text="OVERALL EKF ESTIMATOR HEALTH" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold"/>
                                            <Label x:Name="LBL_ekf_health_desc" Text="Attitude &amp; Position variance within safe limits" TextColor="#CBD5E1" FontSize="10"/>
                                        </StackLayout>
                                        <Frame Grid.Column="1" x:Name="Frame_ekf_health_badge" BackgroundColor="#064E3B" BorderColor="#10B981" CornerRadius="6" Padding="8,3" HasShadow="False" VerticalOptions="Center">
                                            <Label x:Name="LBL_ekf_health_badge" Text="🟢 OPTIMAL (0.00)" TextColor="#10B981" FontSize="11" FontAttributes="Bold"/>
                                        </Frame>
                                    </Grid>
                                </Frame>

                                <!-- Variances Card (5 Items) -->
                                <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                    <StackLayout Spacing="6">
                                        <Label Text="ESTIMATOR VARIANCES (0.00 ~ 1.00)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                        
                                        <!-- Velocity Variance -->
                                        <Grid ColumnDefinitions="140,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Velocity Horiz" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_ekf_vel" Grid.Column="1" Text="0.00" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_ekf_vel" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Pos Horiz Variance -->
                                        <Grid ColumnDefinitions="140,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Pos Horiz" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_ekf_posh" Grid.Column="1" Text="0.00" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_ekf_posh" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Pos Vert Variance -->
                                        <Grid ColumnDefinitions="140,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Pos Vert" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_ekf_posv" Grid.Column="1" Text="0.00" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_ekf_posv" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Compass Variance -->
                                        <Grid ColumnDefinitions="140,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Compass Heading" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_ekf_comp" Grid.Column="1" Text="0.00" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_ekf_comp" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Terrain Alt Variance -->
                                        <Grid ColumnDefinitions="140,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Terrain Altitude" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_ekf_terrain" Grid.Column="1" Text="0.00" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_ekf_terrain" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>
                                    </StackLayout>
                                </Frame>

                                <!-- EKF Flags Card -->
                                <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                    <StackLayout Spacing="4">
                                        <Label Text="ESTIMATOR STATUS FLAGS" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="3">
                                            <Label x:Name="LBL_ekfflag_0" Grid.Row="0" Grid.Column="0" Text="Attitude: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_1" Grid.Row="0" Grid.Column="1" Text="Vel Horiz: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_2" Grid.Row="0" Grid.Column="2" Text="Pos Horiz Rel: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_3" Grid.Row="1" Grid.Column="0" Text="Pos Horiz Abs: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_4" Grid.Row="1" Grid.Column="1" Text="Pos Vert Abs: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_5" Grid.Row="1" Grid.Column="2" Text="Pos Vert AGL: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_6" Grid.Row="2" Grid.Column="0" Text="Const Pos: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_7" Grid.Row="2" Grid.Column="1" Text="Pred Horiz Rel: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_8" Grid.Row="2" Grid.Column="2" Text="Pred Horiz Abs: OFF" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_9" Grid.Row="3" Grid.Column="0" Text="GPS Glitch: NO" TextColor="#94A3B8" FontSize="9"/>
                                            <Label x:Name="LBL_ekfflag_10" Grid.Row="3" Grid.Column="1" Text="Accel Error: NO" TextColor="#94A3B8" FontSize="9"/>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </ScrollView>

                        <!-- ================= Vibration & Clipping View ================= -->
                        <ScrollView x:Name="View_Diag_Vibe" IsVisible="False">
                            <StackLayout Spacing="8">
                                <!-- Vibration Levels Card (3 Axes) -->
                                <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                    <StackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="IMU VIBRATION ACCELERATION (m/s²)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Norm: &lt;30 | Warn: 30-60 | Crit: &gt;60" TextColor="#64748B" FontSize="8" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Vibe X -->
                                        <Grid ColumnDefinitions="90,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Vibe X (Pitch)" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_vibe_x" Grid.Column="1" Text="0 m/s²" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_vibe_x" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Vibe Y -->
                                        <Grid ColumnDefinitions="90,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Vibe Y (Roll)" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_vibe_y" Grid.Column="1" Text="0 m/s²" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_vibe_y" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>

                                        <!-- Vibe Z -->
                                        <Grid ColumnDefinitions="90,50,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="Vibe Z (Yaw)" TextColor="#E2E8F0" FontSize="10" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_vibe_z" Grid.Column="1" Text="0 m/s²" TextColor="#10B981" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                            <ProgressBar x:Name="PB_vibe_z" Grid.Column="2" Progress="0.0" ProgressColor="#10B981" HeightRequest="6" VerticalOptions="Center"/>
                                        </Grid>
                                    </StackLayout>
                                </Frame>

                                <!-- Clipping Counters Card -->
                                <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                    <StackLayout Spacing="6">
                                        <Label Text="IMU CLIPPING COUNTERS (SENSOR SATURATION)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                            <!-- Clip 0 (IMU 1) -->
                                            <Frame Grid.Column="0" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="6,4" HasShadow="False">
                                                <StackLayout Spacing="1" HorizontalOptions="Center">
                                                    <Label Text="IMU 1 (Clip 0)" TextColor="#94A3B8" FontSize="8" HorizontalTextAlignment="Center"/>
                                                    <Label x:Name="LBL_vibe_clip0" Text="0" TextColor="#10B981" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                                </StackLayout>
                                            </Frame>
                                            <!-- Clip 1 (IMU 2) -->
                                            <Frame Grid.Column="1" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="6,4" HasShadow="False">
                                                <StackLayout Spacing="1" HorizontalOptions="Center">
                                                    <Label Text="IMU 2 (Clip 1)" TextColor="#94A3B8" FontSize="8" HorizontalTextAlignment="Center"/>
                                                    <Label x:Name="LBL_vibe_clip1" Text="0" TextColor="#10B981" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                                </StackLayout>
                                            </Frame>
                                            <!-- Clip 2 (IMU 3) -->
                                            <Frame Grid.Column="2" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="6,4" HasShadow="False">
                                                <StackLayout Spacing="1" HorizontalOptions="Center">
                                                    <Label Text="IMU 3 (Clip 2)" TextColor="#94A3B8" FontSize="8" HorizontalTextAlignment="Center"/>
                                                    <Label x:Name="LBL_vibe_clip2" Text="0" TextColor="#10B981" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </StackLayout>
                                </Frame>

                                <!-- Guidance / Tips Card -->
                                <Frame BackgroundColor="#0F172A" BorderColor="#1E293B" CornerRadius="8" Padding="10,6" HasShadow="False">
                                    <StackLayout Spacing="2">
                                        <Label Text="💡 VIBRATION GUIDELINES:" TextColor="#CBD5E1" FontSize="9" FontAttributes="Bold"/>
                                        <Label Text="• X / Y Vibration: Under 30 m/s² is normal. Check propeller balance and deformation." TextColor="#94A3B8" FontSize="8"/>
                                        <Label Text="• Z Vibration: Under 60 m/s² is normal. Check motor shaft wobble and frame rigidity." TextColor="#94A3B8" FontSize="8"/>
                                        <Label Text="• Clipping: IMU sensor saturation (±16G). Excessive clipping causes EKF attitude divergence." TextColor="#94A3B8" FontSize="8"/>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </ScrollView>

                        <!-- ================= 3. SENSOR & CALIBRATION INSPECTOR VIEW ================= -->
                        <Grid x:Name="View_Diag_Calib" IsVisible="False" ColumnDefinitions="185,*" ColumnSpacing="8">
                            <!-- Left Column: Item Tree / Category List -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="6,8" HasShadow="False">
                                <ScrollView>
                                    <StackLayout Spacing="5">
                                        <!-- 📁 SENSORS -->
                                        <Label Text="📁 SENSORS" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" Margin="4,2,0,0"/>
                                        
                                        <Frame x:Name="Tree_Item_Accel" BackgroundColor="#0284C7" BorderColor="#38BDF8" CornerRadius="6" Padding="8,6" HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTreeAccelClicked"/>
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Text="📐" FontSize="11" VerticalOptions="Center"/>
                                                <Label x:Name="LBL_Tree_Accel" Grid.Column="1" Text="Accelerometer (Accel)" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label x:Name="Badge_Tree_Accel" Grid.Column="2" Text="🟢" FontSize="10" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>

                                        <Frame x:Name="Tree_Item_Gyro" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="8,6" HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTreeGyroClicked"/>
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Text="🔄" FontSize="11" VerticalOptions="Center"/>
                                                <Label x:Name="LBL_Tree_Gyro" Grid.Column="1" Text="Gyroscope (Gyro)" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label x:Name="Badge_Tree_Gyro" Grid.Column="2" Text="🟢" FontSize="10" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>

                                        <Frame x:Name="Tree_Item_Compass" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="8,6" HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTreeCompassClicked"/>
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Text="🧭" FontSize="11" VerticalOptions="Center"/>
                                                <Label x:Name="LBL_Tree_Compass" Grid.Column="1" Text="Compass (Mag)" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label x:Name="Badge_Tree_Compass" Grid.Column="2" Text="🟢" FontSize="10" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>

                                        <BoxView HeightRequest="1" BackgroundColor="#334155" Margin="0,3"/>

                                        <!-- 📁 プロポ / 送信機 (RADIO / RC) -->
                                        <Label Text="📁 RADIO / RC" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" Margin="4,0,0,0"/>

                                        <Frame x:Name="Tree_Item_Radio" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="8,6" HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTreeRadioClicked"/>
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Text="🎮" FontSize="11" VerticalOptions="Center"/>
                                                <Label x:Name="LBL_Tree_Radio" Grid.Column="1" Text="Transmitter RC (CH1-18)" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label x:Name="Badge_Tree_Radio" Grid.Column="2" Text="🟢" FontSize="10" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>

                                        <BoxView HeightRequest="1" BackgroundColor="#334155" Margin="0,3"/>

                                        <!-- 📁 MOTORS & ESC -->
                                        <Label Text="📁 MOTORS &amp; ESC" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" Margin="4,0,0,0"/>

                                        <Frame x:Name="Tree_Item_Esc" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="8,6" HasShadow="False">
                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTreeEscClicked"/>
                                            </Frame.GestureRecognizers>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                                <Label Text="⚡" FontSize="11" VerticalOptions="Center"/>
                                                <Label x:Name="LBL_Tree_Esc" Grid.Column="1" Text="PWM Range &amp; Spin" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label x:Name="Badge_Tree_Esc" Grid.Column="2" Text="🟢" FontSize="10" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>
                                    </StackLayout>
                                </ScrollView>
                            </Frame>

                            <!-- Right Column: Details & Advice Panel -->
                            <ScrollView Grid.Column="1">
                                <StackLayout Spacing="8">
                                    <!-- Header Card -->
                                    <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,8" HasShadow="False">
                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                            <StackLayout Orientation="Vertical" Spacing="2">
                                                <Label x:Name="LBL_calib_title" Text="[ Accelerometer (IMU 1) ]" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold"/>
                                                <Label x:Name="LBL_calib_subtitle" Text="6-Point Calibration, Offsets &amp; Level Trim" TextColor="#94A3B8" FontSize="9"/>
                                            </StackLayout>
                                            <Frame Grid.Column="1" x:Name="Frame_calib_status_badge" BackgroundColor="#064E3B" BorderColor="#10B981" CornerRadius="6" Padding="8,3" HasShadow="False" VerticalOptions="Center">
                                                <Label x:Name="LBL_calib_status_badge" Text="🟢 OPTIMAL" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                            </Frame>
                                        </Grid>
                                    </Frame>

                                    <!-- Live Telemetry Preview Card -->
                                    <Frame x:Name="Frame_calib_live" BackgroundColor="#0F172A" BorderColor="#1E293B" CornerRadius="6" Padding="8,5" HasShadow="False">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                                            <Label Text="📡 Live Sensor Values:" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_calib_live_values" Grid.Column="1" Text="X: 0.00  Y: 0.00  Z: -9.80 m/s²" TextColor="#F1F5F9" FontSize="9" VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>



                                    <!-- Parameter Table Card -->
                                    <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="8,8" HasShadow="False">
                                        <StackLayout Spacing="4">
                                            <!-- Table Header Row -->
                                            <Grid ColumnDefinitions="130,120,70,60,85,60" ColumnSpacing="4" BackgroundColor="#0F172A" Padding="6,4">
                                                <Label Text="Parameter" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold"/>
                                                <Label Grid.Column="1" Text="Description" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold"/>
                                                <Label Grid.Column="2" Text="Value" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                                                <Label Grid.Column="3" Text="Ideal" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                                                <Label Grid.Column="4" Text="Tolerance" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                                <Label Grid.Column="5" Text="Status" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                            </Grid>
                                            <!-- Dynamic Table Rows Container -->
                                            <StackLayout x:Name="Stack_Calib_TableRows" Spacing="2"/>
                                        </StackLayout>
                                    </Frame>

                                    <!-- Diagnostic Advice Card -->
                                    <Frame x:Name="Frame_calib_advice" BackgroundColor="#064E3B" BorderColor="#10B981" CornerRadius="8" Padding="10,8" HasShadow="False">
                                        <StackLayout Spacing="3">
                                            <Label x:Name="LBL_calib_advice_title" Text="💡 Diagnosis: Optimal" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                            <Label x:Name="LBL_calib_advice_cause" Text="[Status] Sensor offsets and scaling are within ideal limits." TextColor="#E2E8F0" FontSize="8"/>
                                            <Label x:Name="LBL_calib_advice_action" Text="[Advice] Calibration is valid and safe for flight. No recalibration needed." TextColor="#94A3B8" FontSize="8"/>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </ScrollView>
                        </Grid>
                    </Grid>
                </Grid>
            </Frame>
        </Grid>

    
        <!-- ================= 6. VIBRATION & HAPTICS SETTINGS & PATTERN SELECTOR MODAL ================= -->
        <Grid x:Name="Popup_VibeTest" Margin="0" Padding="12" BackgroundColor="#D90B1120" IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseVibeTestPopup_Clicked" NumberOfTapsRequired="1"/>
            </Grid.GestureRecognizers>
            <Frame BackgroundColor="#0F172A" BorderColor="#10B981" CornerRadius="12" Padding="14,10"
                   HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="530" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEmptyTapIgnored" NumberOfTapsRequired="1"/>
                </Frame.GestureRecognizers>
                <StackLayout Spacing="6">
                    <!-- Header Row -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                            <Label Text="📳" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Vibration &amp; Haptic Settings" TextColor="#38BDF8" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                        <Button Grid.Column="1" Text="✕" FontSize="11" FontAttributes="Bold"
                                BackgroundColor="#EF4444" TextColor="#FFFFFF" CornerRadius="4"
                                WidthRequest="26" HeightRequest="26" Padding="0" Clicked="CloseVibeTestPopup_Clicked"/>
                    </Grid>

                    <!-- Subtitle & Description -->
                    <Label Text="Configure vibration haptic patterns for flight events (settings saved automatically)."
                           TextColor="#94A3B8" FontSize="8"/>

                    <!-- Master & Device Switches Bar -->
                    <Frame BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="8" Padding="10,6" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" VerticalOptions="Center">
                            <!-- Master Switch -->
                            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                                <CheckBox x:Name="CHK_Vibe_MasterEnabled" Color="#10B981" VerticalOptions="Center"/>
                                <Label Text="Master Enable" TextColor="#F1F5F9" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>

                            <BoxView Grid.Column="1" WidthRequest="1" BackgroundColor="#334155" HorizontalOptions="Center" HeightRequest="20"/>

                            <!-- Gamepad Switch -->
                            <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                                <CheckBox x:Name="CHK_Vibe_Gamepad" Color="#38BDF8" VerticalOptions="Center"/>
                                <Label Text="🎮 Gamepad" TextColor="#CBD5E1" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>

                            <BoxView Grid.Column="3" WidthRequest="1" BackgroundColor="#334155" HorizontalOptions="Center" HeightRequest="20"/>

                            <!-- Phone Switch -->
                            <StackLayout Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                                <CheckBox x:Name="CHK_Vibe_Phone" Color="#F59E0B" VerticalOptions="Center"/>
                                <Label Text="📱 Phone / Tablet" TextColor="#CBD5E1" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </Frame>

                    <!-- ScrollView for 5 Event Pattern Cards -->
                    <ScrollView HeightRequest="215" Orientation="Vertical">
                        <StackLayout Spacing="5" Padding="0,2,4,2">
                            <!-- 1. ARM -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#10B981" CornerRadius="6" Padding="8,4" HasShadow="False">
                                <Grid ColumnDefinitions="140,*,65" ColumnSpacing="6" VerticalOptions="Center">
                                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="🟢 ARM (Motors Spin)" TextColor="#10B981" FontSize="10" FontAttributes="Bold"/>
                                        <Label Text="Motors started" TextColor="#94A3B8" FontSize="7"/>
                                    </StackLayout>
                                    <Picker x:Name="Picker_Vibe_Arm" Grid.Column="1" TextColor="#F1F5F9" FontSize="9" HeightRequest="32" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>🟢 Pattern 1: ARM Short Pulse (140ms x2)</x:String>
                                            <x:String>🔴 Pattern 2: DISARM Mid Pulse (280ms x1)</x:String>
                                            <x:String>🔋 Pattern 3: Low Battery Pulse (180ms x2)</x:String>
                                            <x:String>⚠️ Pattern 4: Critical Battery (300ms x3)</x:String>
                                            <x:String>🚨 Pattern 5: Anomaly / Failsafe (450ms x3)</x:String>
                                            <x:String>🚫 None (Haptics OFF)</x:String>
                                        </Picker.Items>
                                        <Picker.SelectedIndex>0</Picker.SelectedIndex>
                                    </Picker>
                                    <Button Grid.Column="2" Text="📳 Test" BackgroundColor="#059669" TextColor="#FFFFFF"
                                            FontSize="8" FontAttributes="Bold" HeightRequest="26" Padding="0" CornerRadius="4"
                                            Clicked="TestVibe_Arm_Clicked"/>
                                </Grid>
                            </Frame>

                            <!-- 2. DISARM -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#EF4444" CornerRadius="6" Padding="8,4" HasShadow="False">
                                <Grid ColumnDefinitions="140,*,65" ColumnSpacing="6" VerticalOptions="Center">
                                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="🔴 DISARM (Motors Stop)" TextColor="#F87171" FontSize="10" FontAttributes="Bold"/>
                                        <Label Text="Motors stopped" TextColor="#94A3B8" FontSize="7"/>
                                    </StackLayout>
                                    <Picker x:Name="Picker_Vibe_Disarm" Grid.Column="1" TextColor="#F1F5F9" FontSize="9" HeightRequest="32" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>🟢 Pattern 1: ARM Short Pulse (140ms x2)</x:String>
                                            <x:String>🔴 Pattern 2: DISARM Mid Pulse (280ms x1)</x:String>
                                            <x:String>🔋 Pattern 3: Low Battery Pulse (180ms x2)</x:String>
                                            <x:String>⚠️ Pattern 4: Critical Battery (300ms x3)</x:String>
                                            <x:String>🚨 Pattern 5: Anomaly / Failsafe (450ms x3)</x:String>
                                            <x:String>🚫 None (Haptics OFF)</x:String>
                                        </Picker.Items>
                                        <Picker.SelectedIndex>1</Picker.SelectedIndex>
                                    </Picker>
                                    <Button Grid.Column="2" Text="📳 Test" BackgroundColor="#DC2626" TextColor="#FFFFFF"
                                            FontSize="8" FontAttributes="Bold" HeightRequest="26" Padding="0" CornerRadius="4"
                                            Clicked="TestVibe_Disarm_Clicked"/>
                                </Grid>
                            </Frame>

                            <!-- 3. Battery Warning -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#F59E0B" CornerRadius="6" Padding="8,4" HasShadow="False">
                                <Grid ColumnDefinitions="140,*,65" ColumnSpacing="6" VerticalOptions="Center">
                                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="🔋 Battery Warning" TextColor="#F59E0B" FontSize="10" FontAttributes="Bold"/>
                                        <Label Text="Low Voltage &lt; 3.55V (7s interval)" TextColor="#94A3B8" FontSize="7"/>
                                    </StackLayout>
                                    <Picker x:Name="Picker_Vibe_BattWarn" Grid.Column="1" TextColor="#F1F5F9" FontSize="9" HeightRequest="32" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>🟢 Pattern 1: ARM Short Pulse (140ms x2)</x:String>
                                            <x:String>🔴 Pattern 2: DISARM Mid Pulse (280ms x1)</x:String>
                                            <x:String>🔋 Pattern 3: Low Battery Pulse (180ms x2)</x:String>
                                            <x:String>⚠️ Pattern 4: Critical Battery (300ms x3)</x:String>
                                            <x:String>🚨 Pattern 5: Anomaly / Failsafe (450ms x3)</x:String>
                                            <x:String>🚫 None (Haptics OFF)</x:String>
                                        </Picker.Items>
                                        <Picker.SelectedIndex>2</Picker.SelectedIndex>
                                    </Picker>
                                    <Button Grid.Column="2" Text="📳 Test" BackgroundColor="#D97706" TextColor="#FFFFFF"
                                            FontSize="8" FontAttributes="Bold" HeightRequest="26" Padding="0" CornerRadius="4"
                                            Clicked="TestVibe_BattWarn_Clicked"/>
                                </Grid>
                            </Frame>

                            <!-- 4. Battery Critical -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#F97316" CornerRadius="6" Padding="8,4" HasShadow="False">
                                <Grid ColumnDefinitions="140,*,65" ColumnSpacing="6" VerticalOptions="Center">
                                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="⚠️ Battery Critical" TextColor="#F97316" FontSize="10" FontAttributes="Bold"/>
                                        <Label Text="Critical Voltage &lt; 3.30V (3.5s interval)" TextColor="#94A3B8" FontSize="7"/>
                                    </StackLayout>
                                    <Picker x:Name="Picker_Vibe_BattCrit" Grid.Column="1" TextColor="#F1F5F9" FontSize="9" HeightRequest="32" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>🟢 Pattern 1: ARM Short Pulse (140ms x2)</x:String>
                                            <x:String>🔴 Pattern 2: DISARM Mid Pulse (280ms x1)</x:String>
                                            <x:String>🔋 Pattern 3: Low Battery Pulse (180ms x2)</x:String>
                                            <x:String>⚠️ Pattern 4: Critical Battery (300ms x3)</x:String>
                                            <x:String>🚨 Pattern 5: Anomaly / Failsafe (450ms x3)</x:String>
                                            <x:String>🚫 None (Haptics OFF)</x:String>
                                        </Picker.Items>
                                        <Picker.SelectedIndex>3</Picker.SelectedIndex>
                                    </Picker>
                                    <Button Grid.Column="2" Text="📳 Test" BackgroundColor="#EA580C" TextColor="#FFFFFF"
                                            FontSize="8" FontAttributes="Bold" HeightRequest="26" Padding="0" CornerRadius="4"
                                            Clicked="TestVibe_BattCrit_Clicked"/>
                                </Grid>
                            </Frame>

                            <!-- 5. Anomaly & Failsafe -->
                            <Frame BackgroundColor="#1E293B" BorderColor="#DC2626" CornerRadius="6" Padding="8,4" HasShadow="False">
                                <Grid ColumnDefinitions="140,*,65" ColumnSpacing="6" VerticalOptions="Center">
                                    <StackLayout Grid.Column="0" VerticalOptions="Center" Spacing="1">
                                        <Label Text="🚨 Anomaly / Failsafe" TextColor="#EF4444" FontSize="10" FontAttributes="Bold"/>
                                        <Label Text="EKF, High Vibe, or Failsafe" TextColor="#94A3B8" FontSize="7"/>
                                    </StackLayout>
                                    <Picker x:Name="Picker_Vibe_Anomaly" Grid.Column="1" TextColor="#F1F5F9" FontSize="9" HeightRequest="32" VerticalOptions="Center">
                                        <Picker.Items>
                                            <x:String>🟢 Pattern 1: ARM Short Pulse (140ms x2)</x:String>
                                            <x:String>🔴 Pattern 2: DISARM Mid Pulse (280ms x1)</x:String>
                                            <x:String>🔋 Pattern 3: Low Battery Pulse (180ms x2)</x:String>
                                            <x:String>⚠️ Pattern 4: Critical Battery (300ms x3)</x:String>
                                            <x:String>🚨 Pattern 5: Anomaly / Failsafe (450ms x3)</x:String>
                                            <x:String>🚫 None (Haptics OFF)</x:String>
                                        </Picker.Items>
                                        <Picker.SelectedIndex>4</Picker.SelectedIndex>
                                    </Picker>
                                    <Button Grid.Column="2" Text="📳 Test" BackgroundColor="#991B1B" TextColor="#FEE2E2"
                                            FontSize="8" FontAttributes="Bold" HeightRequest="26" Padding="0" CornerRadius="4"
                                            Clicked="TestVibe_Anomaly_Clicked"/>
                                </Grid>
                            </Frame>
                        </StackLayout>
                    </ScrollView>

                    <!-- Bottom Action Buttons -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                        <Button Grid.Column="0" Text="🔄 Reset Defaults" BackgroundColor="#334155" TextColor="#F1F5F9"
                                FontSize="9" FontAttributes="Bold" HeightRequest="28" Padding="8,0" CornerRadius="4"
                                Clicked="Btn_Vibe_ResetDefaults_Clicked"/>
                        <Button Grid.Column="1" Text="🔁 Play All Patterns" BackgroundColor="#0D9488" TextColor="#FFFFFF"
                                FontSize="9" FontAttributes="Bold" HeightRequest="28" Padding="6,0" CornerRadius="4"
                                Clicked="TestVibe_PlayAll_Clicked"/>
                        <Button Grid.Column="2" Text="💾 Save &amp; Close" BackgroundColor="#2563EB" TextColor="#FFFFFF"
                                FontSize="9" FontAttributes="Bold" HeightRequest="28" Padding="12,0" CornerRadius="4"
                                Clicked="CloseVibeTestPopup_Clicked"/>
                    </Grid>
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>