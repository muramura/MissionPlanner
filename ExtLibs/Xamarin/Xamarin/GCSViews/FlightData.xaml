<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:controls="clr-namespace:MissionPlanner.Controls;assembly=Xamarin"
             xmlns:GMap="clr-namespace:GMap.NET.WindowsForms;assembly=Xamarin"
             x:Class="Xamarin.FlightData"
             BackgroundColor="#111827">

    <!-- ROOT CONTAINER: 100% FULL SCREEN SATELLITE MAP WITH FLOATING OVERLAYS -->
    <Grid Margin="0" Padding="0">

        <!-- 1. FULL-SCREEN SATELLITE MAP (画面全体) -->
        <GMap:GMapControl x:Name="gMapControl1" BackgroundColor="#111827"
                          VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>

        <!-- ================= 2. TOP FULL-WIDTH TELEMETRY & CONTROL BAR ================= -->
        <Frame Margin="0" Padding="12,4" CornerRadius="0" HasShadow="False"
               BackgroundColor="#590F172A" BorderColor="#475569"
               HeightRequest="34" VerticalOptions="Start" HorizontalOptions="FillAndExpand">
            <Grid VerticalOptions="CenterAndExpand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: StampFly Logo, GNSS Status, Drone Battery, Phone Battery, Message Button -->
                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <!-- Logo (Clean Text) -->
                    <Label Text="StampFly" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    
                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="#475569" VerticalOptions="Center"/>
                    
                    <!-- GNSS Status -->
                    <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                        <Label Text="🛰️" FontSize="11" VerticalOptions="Center"/>
                        <Label x:Name="LBL_gps_status" Text="No GPS" TextColor="#F87171" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- Drone Battery -->
                    <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                        <Label Text="🔋" FontSize="12" VerticalOptions="Center"/>
                        <Label x:Name="LBL_battery_volt" Text="-- V" TextColor="#10B981" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- Android Phone Battery -->
                    <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                        <Label Text="📱" FontSize="11" VerticalOptions="Center"/>
                        <Label x:Name="LBL_phone_battery" Text="--%" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- FC / MP Messages Button -->
                    <Frame BackgroundColor="#1E293B" CornerRadius="5" Padding="6,2" HasShadow="False" VerticalOptions="Center" BorderColor="#475569">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                            <Label Text="💬" FontSize="11" VerticalOptions="Center"/>
                            <Label Text="MSG" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- SETUP Suite Button (Left Toolbar) -->
                    <Frame BackgroundColor="#0284C7" CornerRadius="5" Padding="8,2" HasShadow="False" VerticalOptions="Center" BorderColor="#38BDF8">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSetupModalClicked"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                            <Label Text="🛠️" FontSize="11" VerticalOptions="Center"/>
                            <Label Text="SETUP" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <!-- JOYSTICK Setup Button (Top Toolbar) -->
                    <Frame BackgroundColor="#2563EB" CornerRadius="5" Padding="8,2" HasShadow="False" VerticalOptions="Center" BorderColor="#60A5FA">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenJoystickModalClicked"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                            <Label Text="🎮" FontSize="11" VerticalOptions="Center"/>
                            <Label Text="JOYSTICK" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>

                <!-- Center: Flight Mode & Telemetry Link -->
                <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                    <!-- Flight Mode Selector Pill -->
                    <Frame BackgroundColor="#1E293B" CornerRadius="5" Padding="6,2" HasShadow="False" VerticalOptions="Center" BorderColor="#475569">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFlightModeTapped"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                            <Label Text="🕹️" FontSize="11" VerticalOptions="Center"/>
                            <Label x:Name="LBL_mode_val" Text="STABILIZE ▾" TextColor="#F59E0B" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <!-- Link Quality -->
                    <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                        <Label Text="📶" FontSize="11" VerticalOptions="Center"/>
                        <Label x:Name="LBL_link_val" Text="0%" TextColor="#10B981" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>
                </StackLayout>

                <!-- Right: Arm/Disarm Status & Emergency Land Button -->
                <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                    <!-- Arm/Disarm Status Pill -->
                    <Frame BackgroundColor="#1E293B" CornerRadius="5" Padding="6,2" HasShadow="False" VerticalOptions="Center" BorderColor="#475569">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMotorControlTapped"/>
                        </Frame.GestureRecognizers>
                        <Label x:Name="LBL_arm_val" Text="🔴 DISARMED ▾" TextColor="#EF4444" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Frame>

                    <!-- Emergency Land Button -->
                    <Frame BackgroundColor="#DC2626" CornerRadius="5" Padding="8,2" HasShadow="False" VerticalOptions="Center" BorderColor="#EF4444">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickLandTapped"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="3" VerticalOptions="Center">
                            <Label Text="🚨" FontSize="11" VerticalOptions="Center"/>
                            <Label Text="EMERGENCY" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- ================= 3. LEFT FOLDABLE FLIGHT DOCK (展開時) ================= -->
        <Frame x:Name="Pnl_FlightDock" Margin="0,38,0,0" Padding="6,6,6,6" CornerRadius="0" HasShadow="False"
               WidthRequest="220" HorizontalOptions="Start" VerticalOptions="Start"
               BackgroundColor="#590F172A" BorderColor="#475569" IsVisible="True">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                
                <!-- 上部: タブセレクター & 畳むボタン -->
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="3">
                    <Button x:Name="Btn_Tab_Quick" Grid.Column="0" Text="Quick" FontSize="9" FontAttributes="Bold"
                            BackgroundColor="#2563EB" TextColor="#FFFFFF" CornerRadius="4" HeightRequest="24" Padding="0"
                            Clicked="OnTabQuickClicked"/>
                    <Button x:Name="Btn_Tab_Actions" Grid.Column="1" Text="Actions" FontSize="9" FontAttributes="Bold"
                            BackgroundColor="#1E293B" TextColor="#94A3B8" CornerRadius="4" HeightRequest="24" Padding="0"
                            Clicked="OnTabActionsClicked"/>
                    <Button x:Name="Btn_Tab_Status" Grid.Column="2" Text="Status" FontSize="9" FontAttributes="Bold"
                            BackgroundColor="#1E293B" TextColor="#94A3B8" CornerRadius="4" HeightRequest="24" Padding="0"
                            Clicked="OnTabStatusClicked"/>
                    <!-- ◀ 折りたたみボタン -->
                    <Button Grid.Column="3" Text="◀" FontSize="11" FontAttributes="Bold"
                            BackgroundColor="#334155" TextColor="#E2E8F0" CornerRadius="4" HeightRequest="24" WidthRequest="24" Padding="0"
                            Clicked="OnCollapseDockClicked"/>
                </Grid>

                <!-- 中央: タブ表示エリア -->
                <Grid Grid.Row="1">
                    <!-- Quick タブ (テレメトリ 2列x4行 = 8項目タイル) -->
                    <ScrollView x:Name="View_QuickTab" IsVisible="True">
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="3" RowSpacing="3">
                            <!-- 1. 高度 -->
                            <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Altitude (Alt)" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_alt" Text="0.0 m" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 2. 速度 -->
                            <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Speed" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_speed" Text="0.0 m/s" TextColor="#10B981" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 3. 方位 -->
                            <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Heading (Yaw)" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_yaw" Text="0° N" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 4. 距離 -->
                            <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Distance (Dist)" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_dist" Text="0.0 m" TextColor="#A78BFA" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 5. 昇降率 -->
                            <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Climb Rate" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_climb" Text="0.0 m/s" TextColor="#F472B6" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 6. 電圧 -->
                            <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Voltage (Volt)" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_volt" Text="-- V" TextColor="#10B981" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 7. 電流 -->
                            <Frame Grid.Row="3" Grid.Column="0" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Current" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_curr" Text="0.0 A" TextColor="#FACC15" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                            <!-- 8. 衛星数 -->
                            <Frame Grid.Row="3" Grid.Column="1" BackgroundColor="#1E293B" CornerRadius="4" Padding="5,3" HasShadow="False" BorderColor="#334155">
                                <StackLayout Spacing="0">
                                    <Label Text="Satellites" TextColor="#94A3B8" FontSize="8"/>
                                    <Label x:Name="LBL_quick_sats" Text="0 sats" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold"/>
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </ScrollView>

                    <!-- Actions タブ (操作ボタン ＆ ジョイスティック設定) -->
                    <ScrollView x:Name="View_ActionsTab" IsVisible="False">
                        <StackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                <Button Grid.Column="0" Text="🛬 LAND" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#D97706" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="OnQuickLandTapped"/>
                                <Button Grid.Column="1" Text="🏠 RTL" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#7C3AED" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="OnQuickRTLTapped"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                <Button Grid.Column="0" Text="🛫 TAKEOFF (1m)" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#0284C7" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="Takeoff_1m_OnClicked"/>
                                <Button Grid.Column="1" Text="🕹️ STABILIZE" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#475569" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="OnModeStabilizeClicked"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                <Button Grid.Column="0" Text="🔒 ALTHOLD" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#475569" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="OnModeAltHoldClicked"/>
                                <Button Grid.Column="1" Text="📍 LOITER" FontSize="9" FontAttributes="Bold"
                                        BackgroundColor="#475569" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="28"
                                        Clicked="OnModeLoiterClicked"/>
                            </Grid>
                            <!-- 🎮 JOYSTICK & KEY SETUP ボタン -->
                            <Button Text="🎮 JOYSTICK &amp; KEY SETUP" FontSize="9" FontAttributes="Bold"
                                    BackgroundColor="#2563EB" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="26"
                                    Clicked="OnOpenJoystickModalClicked"/>

                            <!-- 🛠️ 機体初期設定 (CALIBRATION) ボタン -->
                            <Button Text="🛠️ SETUP &amp; CALIBRATION" FontSize="9" FontAttributes="Bold"
                                    BackgroundColor="#0284C7" TextColor="#FFFFFF" CornerRadius="5" HeightRequest="26"
                                    Clicked="OnOpenSetupModalClicked"/>
                        </StackLayout>
                    </ScrollView>

                    <!-- Status タブ (全テレメトリ変数一覧) -->
                    <ScrollView x:Name="View_StatusTab" IsVisible="False">
                        <StackLayout Spacing="2">
                            <Label x:Name="LBL_status_list" Text="Waiting for telemetry..." TextColor="#CBD5E1" FontSize="9" FontFamily="Monospace"/>
                        </StackLayout>
                    </ScrollView>
                </Grid>

                <!-- 下部: コンパクト丸型HUD & EKF/VIBEクイックバッジ (QUICKタブ選択時のみ表示) -->
                <StackLayout Grid.Row="2" Orientation="Vertical" Spacing="3" HorizontalOptions="Center">
                    <Frame x:Name="Frame_HUD" Margin="0,1,0,0" Padding="0" HasShadow="False"
                           WidthRequest="120" HeightRequest="120" CornerRadius="60" IsClippedToBounds="True"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           BackgroundColor="#590F172A" BorderColor="#475569" IsVisible="True">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHudTapped"/>
                        </Frame.GestureRecognizers>
                        <controls:HUD x:Name="hud1" EnableTouchEvents="True" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>
                    </Frame>

                    <!-- 🧭 EKF & 📳 VIBE Quick Badges (タップで詳細表示) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4" WidthRequest="190" HorizontalOptions="Center">
                        <!-- EKF Badge -->
                        <Frame Grid.Column="0" BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="4" Padding="4,3" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEkfBadgeTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout Orientation="Horizontal" Spacing="3" HorizontalOptions="Center">
                                <Label x:Name="LBL_dock_ekf_dot" Text="🟢" FontSize="8" VerticalOptions="Center"/>
                                <Label x:Name="LBL_dock_ekf_text" Text="EKF: OK" TextColor="#10B981" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>
                        </Frame>

                        <!-- VIBE Badge -->
                        <Frame Grid.Column="1" BackgroundColor="#1E293B" BorderColor="#334155" CornerRadius="4" Padding="4,3" HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVibeBadgeTapped"/>
                            </Frame.GestureRecognizers>
                            <StackLayout Orientation="Horizontal" Spacing="3" HorizontalOptions="Center">
                                <Label x:Name="LBL_dock_vibe_dot" Text="🟢" FontSize="8" VerticalOptions="Center"/>
                                <Label x:Name="LBL_dock_vibe_text" Text="VIBE: 0" TextColor="#10B981" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- ================= 4. 折りたたみ時の最小化サイドバー ================= -->
        <StackLayout x:Name="Pnl_FlightDockCollapsed" Orientation="Vertical" Spacing="4" Margin="0,38,0,0"
                     HorizontalOptions="Start" VerticalOptions="Start" IsVisible="False">
            
            <!-- 🧭 展開ボタン -->
            <Frame BackgroundColor="#590F172A" BorderColor="#475569" CornerRadius="8" Padding="10,6" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExpandDockClicked"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                    <Label Text="🧭" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="OPEN ▶" TextColor="#38BDF8" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- 🛬 着陸 (LAND) -->
            <Frame BackgroundColor="#590F172A" BorderColor="#D97706" CornerRadius="8" Padding="10,6" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickLandTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🛬" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="LAND" TextColor="#FDE68A" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="LAND" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- 🏠 帰還 (RTL) -->
            <Frame BackgroundColor="#590F172A" BorderColor="#8B5CF6" CornerRadius="8" Padding="10,6" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickRTLTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🏠" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="RTL" TextColor="#DDD6FE" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="RTL" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- 🛫 離陸 (Takeoff 1.0m) -->
            <Frame BackgroundColor="#590F172A" BorderColor="#0284C7" CornerRadius="8" Padding="10,6" HasShadow="False">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Takeoff_1m_OnClicked"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🛫" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="TAKEOFF" TextColor="#BAE6FD" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="1.0m" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>
        </StackLayout>

    
        <!-- ================= 5. JOYSTICK & KEY MAPPING SETUP MODAL ================= -->
        <Grid x:Name="Pnl_JoystickModal" Margin="0" Padding="0" BackgroundColor="#D90B1120" IsVisible="False">
            <Frame Margin="16,10" Padding="12,10" CornerRadius="8" HasShadow="True"
                   BackgroundColor="#1E293B" BorderColor="#475569"
                   HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                    
                    <!-- 1. Header & Top Action Buttons -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <StackLayout Grid.Column="0" Orientation="Vertical" Spacing="1" VerticalOptions="Center">
                            <StackLayout Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                                <Label Text="🎮" FontSize="16" VerticalOptions="Center"/>
                                <Label Text="Joystick &amp; Key Mapping Setup" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>
                            <Label Text="Full Mission Planner Specification: Device selection, 16-channel axis calibration, key mapping, and real-time live value feedback."
                                   TextColor="#94A3B8" FontSize="8"/>
                        </StackLayout>

                        <!-- Actions: ENABLE, RESCAN, TEST VIBE, SAVE, CLOSE -->
                        <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                            <StackLayout Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <CheckBox x:Name="CHK_enable_joystick" Color="#10B981" VerticalOptions="Center"
                                          CheckedChanged="OnJoystickEnableCheckedChanged"/>
                                <Label Text="ENABLE" TextColor="#10B981" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                            </StackLayout>
                            <Button Text="🔄 RESCAN" FontSize="9" FontAttributes="Bold"
                                    BackgroundColor="#334155" TextColor="#E2E8F0" CornerRadius="4" HeightRequest="26" Padding="6,0"
                                    Clicked="OnJoystickRescanClicked"/>
                            <Button Text="📳 VIBE" FontSize="9" FontAttributes="Bold"
                                    BackgroundColor="#059669" TextColor="#FFFFFF" CornerRadius="4" HeightRequest="26" Padding="6,0"
                                    Clicked="OnJoystickTestVibeClicked"/>
                            <Button Text="💾 SAVE" FontSize="9" FontAttributes="Bold"
                                    BackgroundColor="#2563EB" TextColor="#FFFFFF" CornerRadius="4" HeightRequest="26" Padding="8,0"
                                    Clicked="OnJoystickSaveClicked"/>
                            <Button Text="✖" FontSize="11" FontAttributes="Bold"
                                    BackgroundColor="#EF4444" TextColor="#FFFFFF" CornerRadius="4" HeightRequest="26" WidthRequest="26" Padding="0"
                                    Clicked="OnCloseJoystickModalClicked"/>
                        </StackLayout>
                    </Grid>

                    <!-- 2. Active Joystick & Stick Mode Selector Row -->
                    <Frame Grid.Row="1" BackgroundColor="#0F172A" BorderColor="#334155" CornerRadius="6" Padding="8,4" HasShadow="False">
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Active Joystick:" TextColor="#CBD5E1" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Picker x:Name="Picker_ActiveJoystick" Grid.Column="1" TextColor="#38BDF8" FontSize="11" HeightRequest="36" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Virtual On-Screen Touch Sticks (Mode 2)</x:String>
                                    <x:String>Bluetooth Gamepad Controller</x:String>
                                    <x:String>USB OTG Radio Transmitter</x:String>
                                </Picker.Items>
                                <Picker.SelectedIndex>0</Picker.SelectedIndex>
                            </Picker>

                            <Label Grid.Column="2" Text="Stick Mode:" TextColor="#CBD5E1" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Picker x:Name="Picker_StickMode" Grid.Column="3" TextColor="#F59E0B" FontSize="11" HeightRequest="36" VerticalOptions="Center">
                                <Picker.Items>
                                    <x:String>Mode 2 (Throttle/Yaw Left, Pitch/Roll Right)</x:String>
