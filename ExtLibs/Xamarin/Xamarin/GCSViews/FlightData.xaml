                                        <Entry x:Name="ENT_RCExpo_16" Grid.Column="3" Text="0" TextColor="#F1F5F9" FontSize="10" HeightRequest="32" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Button x:Name="Btn_Detect_16" Grid.Column="4" Text="DETECT" CommandParameter="16"
                                                FontSize="8" BackgroundColor="#1E293B" TextColor="#94A3B8"
                                                HeightRequest="26" CornerRadius="4" Padding="0" Clicked="OnJoystickDetectClicked"/>
                                        <Label x:Name="LBL_joy_rc16" Grid.Column="5" Text="1500 µs" TextColor="#A78BFA" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                    <!-- RC17 (Aux 13) -->
                                    <Grid ColumnDefinitions="85,90,45,50,60,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="RC17 (Aux 13)" TextColor="#EC4899" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Button x:Name="Btn_RCAxis_17" Grid.Column="1" Text="None ▾" CommandParameter="17"
                                                BackgroundColor="#1E293B" TextColor="#EC4899" FontSize="10" FontAttributes="Bold"
                                                HeightRequest="26" Padding="4,0" CornerRadius="4" Clicked="OnSelectAxisClicked" VerticalOptions="Center"/>
                                        <CheckBox x:Name="CHK_RCRev_17" Grid.Column="2" Color="#EC4899" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Entry x:Name="ENT_RCExpo_17" Grid.Column="3" Text="0" TextColor="#F1F5F9" FontSize="10" HeightRequest="32" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Button x:Name="Btn_Detect_17" Grid.Column="4" Text="DETECT" CommandParameter="17"
                                                FontSize="8" BackgroundColor="#1E293B" TextColor="#94A3B8"
                                                HeightRequest="26" CornerRadius="4" Padding="0" Clicked="OnJoystickDetectClicked"/>
                                        <Label x:Name="LBL_joy_rc17" Grid.Column="5" Text="1500 µs" TextColor="#EC4899" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                    <!-- RC18 (Aux 14) -->
                                    <Grid ColumnDefinitions="85,90,45,50,60,*" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="RC18 (Aux 14)" TextColor="#06B6D4" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Button x:Name="Btn_RCAxis_18" Grid.Column="1" Text="None ▾" CommandParameter="18"
                                                BackgroundColor="#1E293B" TextColor="#06B6D4" FontSize="10" FontAttributes="Bold"
                                                HeightRequest="26" Padding="4,0" CornerRadius="4" Clicked="OnSelectAxisClicked" VerticalOptions="Center"/>
                                        <CheckBox x:Name="CHK_RCRev_18" Grid.Column="2" Color="#06B6D4" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Entry x:Name="ENT_RCExpo_18" Grid.Column="3" Text="0" TextColor="#F1F5F9" FontSize="10" HeightRequest="32" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                        <Button x:Name="Btn_Detect_18" Grid.Column="4" Text="DETECT" CommandParameter="18"
                                                FontSize="8" BackgroundColor="#1E293B" TextColor="#94A3B8"
                                                HeightRequest="26" CornerRadius="4" Padding="0" Clicked="OnJoystickDetectClicked"/>
                                        <Label x:Name="LBL_joy_rc18" Grid.Column="5" Text="1500 µs" TextColor="#06B6D4" FontSize="10" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                    </Grid>
                                </StackLayout>
                            </Frame>

                                                        

                        </StackLayout>
                    </ScrollView>

                </Grid>
            </Frame>
        </Grid>


        <!-- ================= 6. ARDUPILOT CALIBRATION & SETUP SUITE MODAL ================= -->
        <Grid x:Name="Pnl_SetupModal" Margin="0" Padding="0" BackgroundColor="#E60B1120" IsVisible="False">
            <Frame Margin="12,18" Padding="12,10" CornerRadius="12" HasShadow="True"
                   BackgroundColor="#0F172A" BorderColor="#0284C7"
                   VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <!-- Row 0: Title Bar with Close Button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <StackLayout Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                            <Label Text="🛠️" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="ArduPilot Setup &amp; Calibration" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="(SETUP SUITE)" TextColor="#64748B" FontSize="10" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                        <Button Grid.Column="1" Text="✕ Close" BackgroundColor="#334155" TextColor="#F1F5F9" FontSize="11" FontAttributes="Bold"
                                HeightRequest="28" Padding="10,0" CornerRadius="6" Clicked="OnCloseSetupModalClicked"/>
                    </Grid>

                    <!-- Row 1: Sub-tabs (Accel / Compass / Gyro / [Hidden] Radio) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button x:Name="Btn_SetupTab_Accel" Grid.Column="0" Text="📐 Accel"
                                BackgroundColor="#0284C7" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold"
                                HeightRequest="32" CornerRadius="6" Padding="0" Clicked="OnSetupTabAccelClicked"/>
                        <Button x:Name="Btn_SetupTab_Compass" Grid.Column="1" Text="🧭 Compass"
                                BackgroundColor="#1E293B" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold"
                                HeightRequest="32" CornerRadius="6" Padding="0" Clicked="OnSetupTabCompassClicked"/>
                        <Button x:Name="Btn_SetupTab_Gyro" Grid.Column="2" Text="🔄 Gyro / Level"
                                BackgroundColor="#1E293B" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold"
                                HeightRequest="32" CornerRadius="6" Padding="0" Clicked="OnSetupTabGyroClicked"/>
                        <!-- Hidden: Radio (RC) Tab Button (Preserved in code for future expansion) -->
                        <Button x:Name="Btn_SetupTab_Radio" Grid.Column="2" Text="🎮 Radio (RC)" IsVisible="False"
                                BackgroundColor="#1E293B" TextColor="#94A3B8" FontSize="11" FontAttributes="Bold"
                                HeightRequest="32" CornerRadius="6" Padding="0" Clicked="OnSetupTabRadioClicked"/>
                    </Grid>

                    <!-- Row 2: Tab Contents Container -->
                    <Grid Grid.Row="2">
                        <!-- ================= A. 加速度センサーキャリブレーション (Accel) ================= -->
                        <Grid x:Name="View_Setup_Accel" IsVisible="True" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                            <!-- 6-Orientation Indicator Bar (QGC Style) -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                                <!-- 1. Level -->
                                <Frame x:Name="Frame_Pos_Level" Grid.Column="0" BackgroundColor="#1E293B" BorderColor="#0284C7" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_Level" Text="① 🛩️" FontSize="10" TextColor="#38BDF8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Level" FontSize="9" TextColor="#F1F5F9" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <!-- 2. Left -->
                                <Frame x:Name="Frame_Pos_Left" Grid.Column="1" BackgroundColor="#1E293B" BorderColor="#334155" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_Left" Text="② ⬅️" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Left" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <!-- 3. Right -->
                                <Frame x:Name="Frame_Pos_Right" Grid.Column="2" BackgroundColor="#1E293B" BorderColor="#334155" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_Right" Text="③ ➡️" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Right" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <!-- 4. NoseDown -->
                                <Frame x:Name="Frame_Pos_NoseDown" Grid.Column="3" BackgroundColor="#1E293B" BorderColor="#334155" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_NoseDown" Text="④ ⬇️" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Nose Down" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <!-- 5. NoseUp -->
                                <Frame x:Name="Frame_Pos_NoseUp" Grid.Column="4" BackgroundColor="#1E293B" BorderColor="#334155" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_NoseUp" Text="⑤ ⬆️" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Nose Up" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                                <!-- 6. Back -->
                                <Frame x:Name="Frame_Pos_Back" Grid.Column="5" BackgroundColor="#1E293B" BorderColor="#334155" Padding="4,4" CornerRadius="6" HasShadow="False">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPosCardClicked"/>
                                    </Frame.GestureRecognizers>
                                    <StackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label x:Name="Icon_Pos_Back" Text="⑥ 🔄" FontSize="10" TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                                        <Label Text="Back" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Center: 3D Gravity Sphere + Illustration and Guide Messages -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="CenterAndExpand">
                                <!-- 3D Gravity Sphere (1.0G Surface & 6 Orthogonal Positions) -->
                                <Frame Grid.Column="0" BackgroundColor="#020617" BorderColor="#0284C7" Padding="6,4" CornerRadius="8" HasShadow="False"
                                       WidthRequest="240" HeightRequest="210" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid RowDefinitions="18,*,18" RowSpacing="2">
                                        <!-- Header: Title and Tip -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="2,0,2,0">
                                            <Label Grid.Column="0" Text="🌐 3D SPHERE (1.0G)" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Drag to Rotate" TextColor="#64748B" FontSize="8" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- Interactive 3D Canvas -->
                                        <forms:SKCanvasView x:Name="Canvas_Accel3D" Grid.Row="1"
                                                            PaintSurface="OnAccel3DPaintSurface"
                                                            HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <forms:SKCanvasView.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnAccel3DPanUpdated"/>
                                            </forms:SKCanvasView.GestureRecognizers>
                                        </forms:SKCanvasView>
                                        <!-- Footer: Legend and Progress -->
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="2,0,2,0" VerticalOptions="Center">
                                            <Label Text="● Done" TextColor="#10B981" FontSize="8" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="● Target" TextColor="#F59E0B" FontSize="8" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_accel_progress" Grid.Column="2" Text="0 / 6 Done (0%)" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        </Grid>
                                    </Grid>
                                </Frame>

                                <!-- Right Card: Illustration, Step Instructions, and Live Accelerometer Metrics -->
                                <Frame Grid.Column="1" BackgroundColor="#1E293B" BorderColor="#334155" Padding="10,8" CornerRadius="8" HasShadow="False" VerticalOptions="FillAndExpand">
                                    <Grid RowDefinitions="*,Auto" RowSpacing="6">
                                        <!-- Top part: 2D Photo Guide + Title & Instructions -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                            <Frame Grid.Column="0" BackgroundColor="#020617" BorderColor="#334155" Padding="3" CornerRadius="6" HasShadow="False"
                                                   WidthRequest="120" HeightRequest="95" VerticalOptions="Center">
                                                <Image x:Name="IMG_accel_guide" Aspect="AspectFit" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand"/>
                                            </Frame>
                                            <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label x:Name="LBL_accel_title" Text="[1/6] Hold vehicle LEVEL and still" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold"/>
                                                <Label x:Name="LBL_accel_desc" Text="Place the vehicle level and stationary, then click [Position Done] below." TextColor="#94A3B8" FontSize="10"/>
                                                <Label x:Name="LBL_accel_status_msg" Text="Waiting for calibration start..." TextColor="#38BDF8" FontSize="10" FontAttributes="Italic"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Bottom part: Live Vector Components & Stability Badge -->
                                        <Frame Grid.Row="1" BackgroundColor="#0F172A" BorderColor="#334155" Padding="8,4" CornerRadius="6" HasShadow="False">
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                                                    <Label x:Name="LBL_accel_live_xyz" Text="Live: X: +0.00G  Y: +0.00G  Z: +1.00G" TextColor="#CBD5E1" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                                    <Label x:Name="LBL_accel_live_mag" Text="|a|: 1.00G" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                                </StackLayout>
                                                <Frame x:Name="Frm_accel_stability" Grid.Column="1" BackgroundColor="#022C22" BorderColor="#10B981" Padding="6,2" CornerRadius="4" HasShadow="False" VerticalOptions="Center">
                                                    <Label x:Name="LBL_accel_stability" Text="🟢 STABLE" TextColor="#10B981" FontSize="9" FontAttributes="Bold"/>
                                                </Frame>
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </Frame>
                            </Grid>

                            <!-- Bottom Action Buttons -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <Button x:Name="Btn_AccelCal_Simple" Grid.Column="0" Text="⚡ 1-Touch Cal" BackgroundColor="#0D9488" TextColor="#FFFFFF"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="10,0" Clicked="OnAccelCalSimpleClicked"/>
                                <Button x:Name="Btn_AccelCal_Start" Grid.Column="1" Text="🚀 6-Axis Cal" BackgroundColor="#0284C7" TextColor="#FFFFFF"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="10,0" Clicked="OnAccelCalStartClicked"/>
                                <Button x:Name="Btn_AccelCal_Next" Grid.Column="2" Text="✅ Position Done" BackgroundColor="#10B981" TextColor="#FFFFFF"
                                        FontSize="12" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="14,0" IsVisible="False" Clicked="OnAccelCalNextClicked"/>
                                <Button x:Name="Btn_AccelCal_Cancel" Grid.Column="3" Text="✕ Cancel" BackgroundColor="#475569" TextColor="#F1F5F9"
                                        FontSize="11" HeightRequest="34" CornerRadius="6" Padding="10,0" IsVisible="False" Clicked="OnAccelCalCancelClicked"/>
                                <Button x:Name="Btn_AccelCal_Level" Grid.Column="4" Text="📐 Level Trim" BackgroundColor="#334155" TextColor="#38BDF8"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="10,0" Clicked="OnAccelCalLevelOnlyClicked"/>
                            </Grid>
                        </Grid>

                        <!-- ================= B. コンパスキャリブレーション (Compass) ================= -->
                        <Grid x:Name="View_Setup_Compass" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                            <!-- Top: Progress Bars for Compass 1, 2, 3 -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <!-- Compass 1 -->
                                <Frame Grid.Column="0" BackgroundColor="#1E293B" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                    <StackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="🧭 Compass 1 (Primary)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                            <Label x:Name="LBL_compass1_pct" Grid.Column="1" Text="0%" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                        </Grid>
                                        <ProgressBar x:Name="PB_compass1" Progress="0.0" ProgressColor="#0284C7" HeightRequest="8"/>
                                    </StackLayout>
                                </Frame>
                                <!-- Compass 2 -->
                                <Frame Grid.Column="1" BackgroundColor="#1E293B" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                    <StackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="🧭 Compass 2" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                                            <Label x:Name="LBL_compass2_pct" Grid.Column="1" Text="0%" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                                        </Grid>
                                        <ProgressBar x:Name="PB_compass2" Progress="0.0" ProgressColor="#10B981" HeightRequest="8"/>
                                    </StackLayout>
                                </Frame>
                                <!-- Compass 3 -->
                                <Frame Grid.Column="2" BackgroundColor="#1E293B" BorderColor="#334155" Padding="8,6" CornerRadius="6" HasShadow="False">
                                    <StackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="🧭 Compass 3" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                                            <Label x:Name="LBL_compass3_pct" Grid.Column="1" Text="0%" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                                        </Grid>
                                        <ProgressBar x:Name="PB_compass3" Progress="0.0" ProgressColor="#F59E0B" HeightRequest="8"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Center: 3D Point Sampling / Status Card -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="CenterAndExpand">
                                <!-- 80 Points Interactive 3D Sphere Point Cloud Canvas -->
                                <Frame Grid.Column="0" BackgroundColor="#020617" BorderColor="#0284C7" Padding="6,4" CornerRadius="8" HasShadow="False"
                                       WidthRequest="240" HeightRequest="210" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Grid RowDefinitions="18,*,18" RowSpacing="2">
                                        <!-- Header: Title and Tip -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="2,0,2,0">
                                            <Label Grid.Column="0" Text="🌐 3D SPHERE SAMPLES" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="Drag to Rotate" TextColor="#64748B" FontSize="8" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        </Grid>
                                        <!-- Interactive 3D Canvas -->
                                        <forms:SKCanvasView x:Name="Canvas_Compass3D" Grid.Row="1"
                                                            PaintSurface="OnCompass3DPaintSurface"
                                                            HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
                                            <forms:SKCanvasView.GestureRecognizers>
                                                <PanGestureRecognizer PanUpdated="OnCompass3DPanUpdated"/>
                                            </forms:SKCanvasView.GestureRecognizers>
                                        </forms:SKCanvasView>
                                        <!-- Footer: Legend and Progress -->
                                        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" Margin="2,0,2,0" VerticalOptions="Center">
                                            <Label Text="● Ready" TextColor="#10B981" FontSize="8" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="● Missing" TextColor="#EF4444" FontSize="8" VerticalOptions="Center"/>
                                            <Label x:Name="LBL_compass_points" Grid.Column="2" Text="0 / 80 pts (0%)" TextColor="#38BDF8" FontSize="9" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center"/>
                                        </Grid>
                                    </Grid>
                                </Frame>

                                <!-- Compass Result Status & Sphere Quality Card -->
                                <Frame Grid.Column="1" BackgroundColor="#1E293B" BorderColor="#334155" Padding="12,8" CornerRadius="8" HasShadow="False" VerticalOptions="FillAndExpand">
                                    <StackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="Rotate vehicle slowly in all directions (Roll, Pitch, Yaw)." TextColor="#F59E0B" FontSize="11" FontAttributes="Bold"/>
                                        <Label x:Name="LBL_compass_guide_msg" Text="Calibration results will be calculated automatically when bars reach 100%." TextColor="#94A3B8" FontSize="10"/>
                                        <BoxView HeightRequest="1" BackgroundColor="#334155" Margin="0,2"/>
                                        
                                        <!-- Sphere Quality Rating Badge -->
                                        <Frame x:Name="Frm_compass_quality" BackgroundColor="#0F172A" BorderColor="#38BDF8" Padding="8,4" CornerRadius="6" HasShadow="False" HorizontalOptions="Start" IsVisible="False">
                                            <Label x:Name="LBL_compass_quality" Text="🟢 Sphere Quality: Good (Fit: 0.0)" TextColor="#38BDF8" FontSize="11" FontAttributes="Bold"/>
                                        </Frame>

                                        <!-- Detailed Offsets and Status -->
                                        <Label x:Name="LBL_compass_result_text" Text="Waiting (Press Start to begin)" TextColor="#38BDF8" FontSize="10" FontAttributes="Bold"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <!-- Bottom Actions -->
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Button x:Name="Btn_Compass_Start" Grid.Column="0" Text="🚀 Start Mag Cal" BackgroundColor="#0284C7" TextColor="#FFFFFF"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="12,0" Clicked="OnCompassStartClicked"/>
                                <Label Grid.Column="1"/>
                                <Button x:Name="Btn_Compass_Accept" Grid.Column="2" Text="✅ Accept &amp; Save" BackgroundColor="#10B981" TextColor="#FFFFFF"
                                        FontSize="11" FontAttributes="Bold" HeightRequest="34" CornerRadius="6" Padding="12,0" IsVisible="False" Clicked="OnCompassAcceptClicked"/>
                                <Button x:Name="Btn_Compass_Cancel" Grid.Column="3" Text="✕ Cancel" BackgroundColor="#475569" TextColor="#F1F5F9"
                                        FontSize="11" HeightRequest="34" CornerRadius="6" Padding="10,0" IsVisible="False" Clicked="OnCompassCancelClicked"/>
                            </Grid>
                        </Grid>

                        <!-- ================= C. ジャイロ & 水平校正 (Gyro & Level) ================= -->
                        <Grid x:Name="View_Setup_Gyro" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="8">
                            <Frame Grid.Row="0" BackgroundColor="#1E293B" BorderColor="#334155" Padding="14" CornerRadius="8" HasShadow="False" VerticalOptions="CenterAndExpand">
                                <StackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="🔄" FontSize="32" HorizontalTextAlignment="Center"/>
                                    <Label Text="Gyroscope &amp; Horizon Level Calibration" TextColor="#38BDF8" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    <Label Text="Place vehicle on a level, stationary surface. Do not move the vehicle during calibration." TextColor="#94A3B8" FontSize="11" HorizontalTextAlignment="Center"/>
                                    <BoxView HeightRequest="1" BackgroundColor="#334155" Margin="0,4"/>
                                    <Label x:Name="LBL_gyro_attitude_live" Text="Attitude: Roll 0.0° | Pitch 0.0° | Yaw 0.0°" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    <Label x:Name="LBL_gyro_status_msg" Text="Ready" TextColor="#10B981" FontSize="11" HorizontalTextAlignment="Center"/>
                                </StackLayout>
