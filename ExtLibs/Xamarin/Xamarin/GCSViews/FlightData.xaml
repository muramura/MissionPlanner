<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:controls="clr-namespace:MissionPlanner.Controls;assembly=Xamarin"
             xmlns:GMap="clr-namespace:GMap.NET.WindowsForms;assembly=Xamarin"
             x:Class="Xamarin.FlightData"
             BackgroundColor="#111827">

    <!-- ROOT CONTAINER: 100% FULL SCREEN SATELLITE MAP WITH FLOATING OVERLAYS -->
    <Grid Margin="0" Padding="0">

        <!-- 1. FULL-SCREEN SATELLITE MAP (画面全体) -->
        <GMap:GMapControl x:Name="gMapControl1" BackgroundColor="#111827"
                          VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>

        <!-- 2. TOP FULL-WIDTH TELEMETRY & CONTROL BAR (上部・左右密着型グラスモーフィズム) -->
        <Frame Margin="0" Padding="16,4" CornerRadius="0" HasShadow="True"
               BackgroundColor="#8C0F172A" BorderColor="#475569"
               HeightRequest="38" VerticalOptions="Start" HorizontalOptions="FillAndExpand">
            <Grid VerticalOptions="CenterAndExpand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Telemetry & Interactive Mode Picker -->
                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                    <!-- Battery -->
                    <StackLayout Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                        <Label Text="🔋" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LBL_battery_volt" Text="-- V" TextColor="#10B981" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>
                    
                    <BoxView WidthRequest="1" HeightRequest="14" BackgroundColor="#475569" VerticalOptions="Center"/>
                    
                    <!-- Altitude -->
                    <StackLayout Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                        <Label Text="📏" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LBL_alt_val" Text="Alt: 0.0 m" TextColor="#F8FAFC" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>

                    <BoxView WidthRequest="1" HeightRequest="14" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- Interactive Flight Mode Selector Button -->
                    <Frame BackgroundColor="#334155" CornerRadius="6" Padding="8,2" HasShadow="False" VerticalOptions="Center" BorderColor="#475569">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFlightModeTapped"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                            <Label Text="🕹️" FontSize="12" VerticalOptions="Center"/>
                            <Label x:Name="LBL_mode_val" Text="STABILIZE ▾" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <BoxView WidthRequest="1" HeightRequest="14" BackgroundColor="#475569" VerticalOptions="Center"/>

                    <!-- Link Quality -->
                    <StackLayout Orientation="Horizontal" Spacing="4" VerticalOptions="Center">
                        <Label Text="📶" FontSize="13" VerticalOptions="Center"/>
                        <Label x:Name="LBL_link_val" Text="0%" TextColor="#10B981" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                    </StackLayout>
                </StackLayout>

                <!-- Right (電波表示の右側): ARM / DISARM / 緊急着陸 選択ドロップダウン -->
                <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalOptions="Center">
                    <Frame BackgroundColor="#334155" CornerRadius="6" Padding="10,2" HasShadow="False" VerticalOptions="Center" BorderColor="#475569">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMotorControlTapped"/>
                        </Frame.GestureRecognizers>
                        <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                            <Label x:Name="LBL_arm_val" Text="🔴 DISARMED ▾" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- 3. TOP-LEFT FLOATING VERTICAL ACTION ICONS: 🛬着陸 / 🏠帰還 / 🛫離陸 (縦並び) -->
        <StackLayout Orientation="Vertical" Spacing="8" Margin="12,46,0,0"
                     HorizontalOptions="Start" VerticalOptions="Start">
            
            <!-- 🛬 着陸 (LAND) -->
            <Frame BackgroundColor="#8C0F172A" BorderColor="#D97706" CornerRadius="8" Padding="10,6" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickLandTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🛬" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="着陸" TextColor="#FDE68A" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="LAND" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- 🏠 帰還 (RTL) -->
            <Frame BackgroundColor="#8C0F172A" BorderColor="#8B5CF6" CornerRadius="8" Padding="10,6" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuickRTLTapped"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🏠" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="帰還" TextColor="#DDD6FE" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="RTL" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- 🛫 離陸 (1.0m) -->
            <Frame BackgroundColor="#8C0F172A" BorderColor="#3B82F6" CornerRadius="8" Padding="10,6" HasShadow="True">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Takeoff_1m_OnClicked"/>
                </Frame.GestureRecognizers>
                <StackLayout Orientation="Horizontal" Spacing="8" VerticalOptions="Center">
                    <Label Text="🛫" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout Spacing="0" VerticalOptions="Center">
                        <Label Text="離陸" TextColor="#BFDBFE" FontSize="12" FontAttributes="Bold"/>
                        <Label Text="1.0m" TextColor="#94A3B8" FontSize="9"/>
                    </StackLayout>
                </StackLayout>
            </Frame>
        </StackLayout>

        <!-- 4. BOTTOM-LEFT FLOATING HUD PiP -->
        <Frame Margin="12" Padding="0" CornerRadius="12" HasShadow="True"
               WidthRequest="230" HeightRequest="175"
               HorizontalOptions="Start" VerticalOptions="End"
               BackgroundColor="#1F2937" BorderColor="#374151">
            <controls:HUD x:Name="hud1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>
        </Frame>
    </Grid>
</ContentPage>
