<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:SkiaSharp.Views.Forms;assembly=SkiaSharp.Views.Forms"
             xmlns:controls="clr-namespace:MissionPlanner.Controls;assembly=Xamarin"
             xmlns:GMap="clr-namespace:GMap.NET.WindowsForms;assembly=Xamarin"
             x:Class="Xamarin.FlightData"
             BackgroundColor="#111827">

    <Grid Margin="0" Padding="0" RowSpacing="0" ColumnSpacing="0">
        <Grid.RowDefinitions>
            <!-- Top Telemetry Status Bar -->
            <RowDefinition Height="46"/>
            <!-- Main Flight Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP TELEMETRY STATUS BAR -->
        <Frame Grid.Row="0" BackgroundColor="#1F2937" Padding="12,0" Margin="0" HasShadow="False" CornerRadius="0">
            <StackLayout Orientation="Horizontal" VerticalOptions="CenterAndExpand" Spacing="16">
                <Label Text="🔋" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="LBL_battery_volt" Text="4.15 V" TextColor="#10B981" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                
                <BoxView WidthRequest="1" HeightRequest="18" BackgroundColor="#4B5563" VerticalOptions="Center"/>
                
                <Label Text="📏" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="LBL_alt_val" Text="Alt: 0.0 m" TextColor="#F9FAFB" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>

                <BoxView WidthRequest="1" HeightRequest="18" BackgroundColor="#4B5563" VerticalOptions="Center"/>

                <Label Text="🕹️" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="LBL_mode_val" Text="STABILIZE" TextColor="#F59E0B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>

                <BoxView WidthRequest="1" HeightRequest="18" BackgroundColor="#4B5563" VerticalOptions="Center"/>

                <Label Text="📶" FontSize="16" VerticalOptions="Center"/>
                <Label x:Name="LBL_link_val" Text="100%" TextColor="#10B981" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
            </StackLayout>
        </Frame>

        <!-- MAIN FLIGHT & CONTROL GRID -->
        <Grid Grid.Row="1" Margin="0" Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="78*"/>
                <ColumnDefinition Width="22*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: FULL MAP & HUD OVERLAY -->
            <Grid Grid.Column="0" Margin="0" Padding="0">
                <!-- Full Map -->
                <GMap:GMapControl x:Name="gMapControl1" BackgroundColor="#111827"
                                  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>

                <!-- HUD Corner PiP -->
                <Frame Margin="16" Padding="0" CornerRadius="12" HasShadow="True"
                       WidthRequest="220" HeightRequest="170"
                       HorizontalOptions="Start" VerticalOptions="End"
                       BackgroundColor="#1F2937" BorderColor="#374151">
                    <controls:HUD x:Name="hud1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/>
                </Frame>
            </Grid>

            <!-- RIGHT: STAMPFLY TOUCH ACTION PANEL -->
            <Frame Grid.Column="1" BackgroundColor="#1F2430" Padding="8,10" Margin="0" HasShadow="False" CornerRadius="0">
                <ScrollView>
                    <StackLayout Spacing="8">
                        <!-- ARM BUTTON -->
                        <Button x:Name="Arm" Text="🟢 ARM (始動)"
                                BackgroundColor="#059669" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="46"
                                Clicked="Arm_OnClicked"/>

                        <!-- DISARM BUTTON -->
                        <Button x:Name="Disarm" Text="🔴 DISARM (停止)"
                                BackgroundColor="#DC2626" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="46"
                                Clicked="Disarm_OnClicked"/>

                        <BoxView HeightRequest="1" BackgroundColor="#374151" Margin="0,4"/>

                        <!-- TAKEOFF 1m -->
                        <Button x:Name="Takeoff_1m" Text="🛫 離陸 (1.0m)"
                                BackgroundColor="#2563EB" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="44"
                                Clicked="Takeoff_1m_OnClicked"/>

                        <!-- LAND -->
                        <Button x:Name="Land_Btn" Text="🛬 緊急着陸"
                                BackgroundColor="#EA580C" TextColor="White"
                                FontAttributes="Bold" FontSize="13" CornerRadius="8" HeightRequest="44"
                                Clicked="Land_OnClicked"/>

                        <BoxView HeightRequest="1" BackgroundColor="#374151" Margin="0,4"/>

                        <!-- FLIGHT MODES -->
                        <Button x:Name="Btn_AltHold" Text="🕹️ AltHold (高度)"
                                BackgroundColor="#374151" TextColor="#F3F4F6"
                                FontSize="12" CornerRadius="8" HeightRequest="40"
                                Clicked="Btn_AltHold_Clicked"/>

                        <Button x:Name="Btn_Loiter" Text="🕹️ Loiter (定点)"
                                BackgroundColor="#374151" TextColor="#F3F4F6"
                                FontSize="12" CornerRadius="8" HeightRequest="40"
                                Clicked="Btn_Loiter_Clicked"/>

                        <Button x:Name="Btn_Stabilize" Text="🕹️ Stabilize (手動)"
                                BackgroundColor="#374151" TextColor="#F3F4F6"
                                FontSize="12" CornerRadius="8" HeightRequest="40"
                                Clicked="Btn_Stabilize_Clicked"/>

                        <Button x:Name="Btn_RTL" Text="🏠 RTL (帰還)"
                                BackgroundColor="#7C3AED" TextColor="#F3F4F6"
                                FontSize="12" CornerRadius="8" HeightRequest="40"
                                Clicked="Btn_RTL_Clicked"/>

                        <!-- Mode List Fallback -->
                        <Picker x:Name="Mode" Title="Mode Select" TextColor="White" BackgroundColor="#374151"
                                SelectedIndexChanged="Mode_OnSelectedIndexChanged"/>
                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
